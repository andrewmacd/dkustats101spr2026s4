#| label: q2a
#| tbl-cap: "Correlation between top speed and acceleration"
cor.table.data <- evs %>%
mutate(`Top speed (kph)` = TopSpeed_KmH,
`Acceleration per second` = AccelSec) %>%
select(`Top speed (kph)`, `Acceleration per second`)
cor.table.data %>%
correlate() %>%
stretch() %>%
filter(x=="Top speed (kph)" & y=="Acceleration (seconds to 100 kph)") %>%
fashion() %>%
kable() %>%
kable_styling()
